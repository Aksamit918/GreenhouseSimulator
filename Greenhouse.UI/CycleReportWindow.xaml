<Window x:Class="Greenhouse.UI.CycleReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Итоговый отчет цикла (REP-02)" Height="560" Width="700" WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMainTitle" Text="Отчет: Урожай TULIPS" FontWeight="Bold" FontSize="20" Margin="0,0,0,15" Foreground="#333"/>
        
        <TabControl Grid.Row="1" Background="White" BorderBrush="#DDD">
            <!-- БЛОК 1: Агрономия -->
            <TabItem Header="🌱 Агрономический итог">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock x:Name="TxtStatus" Text="СТАТУС: Успех" FontWeight="Bold" FontSize="16" Foreground="Green" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtYieldPercent" Text="Потенциал урожайности: 95%" FontSize="14" Margin="0,5"/>
                        <TextBlock x:Name="TxtLosses" TextWrapping="Wrap" FontSize="14" Foreground="#B71C1C" Margin="0,5" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtUniformity" Text="Индекс равномерности (UI): 98%" FontSize="14" Margin="0,5"/>
                        <TextBlock x:Name="TxtGdd" Text="Накопленные градусо-дни (GDD): 120" FontSize="14" Margin="0,5"/>
                        <TextBlock x:Name="TxtStress" Text="Общий индекс стресса: 2%" FontSize="14" Foreground="Red" Margin="0,5"/>
                        <TextBlock x:Name="TxtConflicts" TextWrapping="Wrap" FontSize="14" Foreground="#E65100" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- БЛОК 3: Экономика -->
            <TabItem Header="💰 Экономика и ресурсы">
                <StackPanel Margin="15">
                    <TextBlock Text="Затраты за цикл:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtPower" Text="Потреблено электроэнергии: 0 кВт*ч" FontSize="14" Margin="0,5"/>
                    <TextBlock x:Name="TxtWater" Text="Расход воды (увлажнители): 0 л" FontSize="14" Margin="0,5"/>
                    <TextBlock x:Name="TxtReagent" Text="Расход реагента (удобрения): 0 мл" FontSize="14" Margin="0,5"/>
                    <Border Background="#FFF3E0" Padding="10" Margin="0,15,0,0" CornerRadius="5">
                        <TextBlock Text="Советник: Оптимизируйте расстановку обогревателей для снижения потребления энергии. Увеличьте КПД ламп." TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="📥 Экспорт в JSON (REP-05)" Click="BtnExport_Click" Padding="15,7" Background="#607D8B" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Click="BtnClose_Click" Padding="15,7"/>
        </StackPanel>
    </Grid>
</Window>
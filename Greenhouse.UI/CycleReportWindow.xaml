<Window x:Class="Greenhouse.UI.CycleReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Итоговый отчет цикла (REP-02)" Height="760" Width="860" WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMainTitle" Text="Отчет: Урожай TULIPS" FontWeight="Bold" FontSize="20" Margin="0,0,0,15" Foreground="#333"/>
        
        <TabControl Grid.Row="1" Background="White" BorderBrush="#DDD">
            <TabItem Header="🌱 Агрономический итог">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock x:Name="TxtStatus" Text="СТАТУС: Успех" FontWeight="Bold" FontSize="16" Foreground="Green" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtYieldPercent" Text="Потенциал урожайности: 95%" FontSize="14" Margin="0,5"/>
                        <TextBlock x:Name="TxtLosses" TextWrapping="Wrap" FontSize="14" Foreground="#B71C1C" Margin="0,5" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtUniformity" Text="Индекс равномерности (UI): 98%" FontSize="14" Margin="0,5"/>
                        <TextBlock x:Name="TxtGdd" Text="Накопленные градусо-дни (GDD): 120" FontSize="14" Margin="0,5"/>
                        <TextBlock x:Name="TxtDli" Text="Накопленный свет (DLI): 0" FontSize="14" Margin="0,5"/>
                        <TextBlock x:Name="TxtStress" Text="Недобор к 100%: 0 п.п." FontSize="14" Foreground="Red" Margin="0,5" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtConflicts" TextWrapping="Wrap" FontSize="14" Foreground="#E65100" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📋 Соблюдение режима">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Время в коридоре" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtSlaTemp" FontSize="14" Margin="0,4"/>
                        <TextBlock x:Name="TxtSlaHumidity" FontSize="14" Margin="0,4"/>
                        <TextBlock x:Name="TxtSlaPh" FontSize="14" Margin="0,4"/>
                        <TextBlock x:Name="TxtSlaLight" FontSize="14" Margin="0,4"/>
                        <TextBlock x:Name="TxtAlertCount" FontSize="14" Margin="0,12,0,4"/>
                        <TextBlock Text="Факторы потерь урожая, п.п." FontWeight="Bold" FontSize="16" Margin="0,12,0,8"/>
                        <TextBlock x:Name="TxtStressSplit" TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Закрыть" Click="BtnClose_Click" Padding="15,7"/>
        </StackPanel>
    </Grid>
</Window>

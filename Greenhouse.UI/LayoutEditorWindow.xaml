<Window x:Class="Greenhouse.UI.LayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор расстановки и свойств" Height="700" Width="1150"
        WindowStartupLocation="CenterOwner" Background="#F0F4F8">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/> <!-- НОВАЯ ПАНЕЛЬ СВОЙСТВ -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ (Палитра) -->
        <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Палитра элементов" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Button x:Name="BtnHelp" Content=" i " HorizontalAlignment="Right" Width="25" Height="25" Background="#2196F3" Foreground="White" Click="BtnHelp_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PalettePanel">
                        <TextBlock Text="Датчики:" Margin="0,0,0,5" Foreground="Gray" FontWeight="Bold"/>
                        <Button Content="🌡 Датчик Температуры" Tag="Sensor_Temp" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,5" Padding="5" Background="#E3F2FD"/>
                        <Button Content="💧 Датчик Влажности" Tag="Sensor_Hum" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,5" Padding="5" Background="#E0F2F1"/>
                        <Button Content="🧪 Датчик pH" Tag="Sensor_Ph" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,15" Padding="5" Background="#FFEBEE"/>

                        <TextBlock Text="Оборудование:" Margin="0,0,0,5" Foreground="Gray" FontWeight="Bold"/>
                        <Button Content="♨️ Обогреватель" Tag="Actuator_Heater" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,5" Padding="5" Background="#F1F8E9"/>
                        <Button Content="❄️ Кондиционер" Tag="Actuator_AC" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,5" Padding="5" Background="#E3F2FD"/>
                        <Button Content="💦 Увлажнитель" Tag="Actuator_Humidifier" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,5" Padding="5" Background="#F3E5F5"/>
                        <Button Content="⚡ Дозатор удобрений" Tag="Actuator_Doser" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,5" Padding="5" Background="#FFF3E0"/>
                        <Button Content="💡 Источник света" Tag="Actuator_Light" PreviewMouseLeftButtonDown="PaletteItem_MouseDown" Margin="0,0,0,5" Padding="5" Background="#FFF9C4"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Button x:Name="BtnRemoveSelected" Content="Удалить выбранный" Padding="8" Margin="0,0,0,8" IsEnabled="False" Click="BtnRemoveSelected_Click"/>
                    <Button x:Name="BtnSaveLayout" Content="💾 Сохранить в теплицу" Padding="10" Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="BtnSaveLayout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ЦЕНТР (Холст) -->
        <Border Grid.Column="1" BorderBrush="#333" BorderThickness="3" Background="White" Margin="0,0,10,0">
            <Canvas x:Name="EditorCanvas" AllowDrop="True" Drop="EditorCanvas_Drop" DragOver="EditorCanvas_DragOver" Background="Transparent" MouseMove="EditorCanvas_MouseMove" MouseLeftButtonUp="EditorCanvas_MouseUp">
                <TextBlock Text="Перетащите элементы сюда" Canvas.Left="20" Canvas.Top="20" Foreground="#CCC" FontSize="20" IsHitTestVisible="False"/>
            </Canvas>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ (Свойства) -->
        <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PropertiesPanel" IsEnabled="False">
                    <TextBlock Text="Свойства элемента" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                    <TextBlock x:Name="TxtPropsTarget" Text="Ничего не выбрано" Foreground="Blue" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel x:Name="ActuatorProps" Visibility="Collapsed">
                        <TextBlock Text="Max Power (Макс. Мощность):" Margin="0,0,0,3"/>
                        <TextBox x:Name="PropMaxPower" Padding="4" Margin="0,0,0,10"/>
                        <TextBlock Text="Effective Radius (Радиус дейст., м):" Margin="0,0,0,3"/>
                        <TextBox x:Name="PropRadius" Padding="4" Margin="0,0,0,10"/>
                        <TextBlock Text="Warmup Time (Прогрев, ч):" Margin="0,0,0,3"/>
                        <TextBox x:Name="PropWarmup" Padding="4" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="LightProps" Visibility="Collapsed">
                        <TextBlock Text="Efficiency (КПД лампы 0..1):" Margin="0,0,0,3"/>
                        <TextBox x:Name="PropEfficiency" Padding="4" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel x:Name="SensorProps" Visibility="Collapsed">
                        <TextBlock Text="Noise Sigma (Шум датчика):" Margin="0,0,0,3"/>
                        <TextBox x:Name="PropNoise" Padding="4" Margin="0,0,0,10"/>
                        <TextBlock Text="Hysteresis (Гистерезис):" Margin="0,0,0,3"/>
                        <TextBox x:Name="PropHysteresis" Padding="4" Margin="0,0,0,10"/>
                    </StackPanel>

                    <Button Content="Применить свойства" Click="BtnApplyProps_Click" Padding="10" Background="#FF9800" Foreground="White" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- СПРАВКА -->
        <Grid x:Name="OverlayHelp" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100" Grid.ColumnSpan="3">
            <Border Background="White" Width="400" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Справка" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="1. Перетаскивайте приборы из палитры на холст.&#x0a;2. Кликните по прибору на холсте, чтобы открыть его физические свойства справа.&#x0a;3. Обязательно нажимайте 'Применить свойства'." TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <Button Content="Понятно" Click="BtnCloseHelp_Click" Padding="20,10" Background="#2196F3" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
<Window x:Class="Greenhouse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Симулятор Теплицы 3000" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    
    <Grid>
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <GroupBox Header="Управление симуляцией" Padding="10" FontWeight="Bold">
                    <StackPanel TextElement.FontWeight="Normal">
                        <TextBlock Text="Выберите план посадки:" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PlansComboBox" Padding="5" Grid.Column="0" Margin="0,0,5,0"/>
                            <Button Content="➕" Grid.Column="1" Width="30" Margin="0,0,5,0" Click="BtnShowNewPlan_Click" ToolTip="Создать новый план" Background="#2196F3" Foreground="White"/>
                            <Button Content="✎" Grid.Column="2" Width="30" Click="BtnEditPlan_Click" ToolTip="Изменить выбранный план" Background="#607D8B" Foreground="White"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnStart" Content="▶ Старт" Padding="10" Background="#4CAF50" Foreground="White" Click="BtnStart_Click" Width="75" Margin="0,0,5,0"/>
                            <Button x:Name="BtnPause" Content="⏸ Пауза" Padding="10" Background="#FF9800" Foreground="White" Click="BtnPause_Click" IsEnabled="False" Width="85" Margin="0,0,5,0"/>
                            <Button x:Name="BtnStop" Content="■ Стоп" Padding="10" Background="#F44336" Foreground="White" Click="BtnStop_Click" IsEnabled="False" Width="70"/>
                        </StackPanel>

                        <!-- Кнопка редактора -->
                        <Button x:Name="BtnOpenEditor" Content="✏️ Открыть редактор расстановки" Padding="7" Margin="0,0,0,10" Background="#607D8B" Foreground="White" Click="BtnOpenEditor_Click"/>

                        <!-- БЛОК HEATMAP (Квадратики) -->
                        <TextBlock Text="Слой тепловой карты (Heatmap):" Margin="0,5,0,5"/>
                        <ComboBox x:Name="HeatmapComboBox" Padding="5" SelectionChanged="HeatmapComboBox_SelectionChanged">
                            <ComboBoxItem Content="Нет (Скрыто)" IsSelected="True"/>
                            <ComboBoxItem Content="Температура (°C)"/>
                            <ComboBoxItem Content="Влажность (%)"/>
                            <ComboBoxItem Content="Освещенность (Lx)"/>
                            <ComboBoxItem Content="Кислотность (pH)"/>
                        </ComboBox>

                        <TextBlock x:Name="TxtStatus" Text="Статус: Остановлено" Margin="0,10,0,0" FontStyle="Italic" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Текущие предупреждения" Margin="0,10,0,0" Padding="10" FontWeight="Bold">
                    <TextBlock x:Name="TxtAlerts" Text="Всё в норме" Foreground="DarkGreen" TextWrapping="Wrap" TextElement.FontWeight="Normal"/>
                </GroupBox>

                <GroupBox Header="Журнал действий автоматики" Margin="0,10,0,0" Padding="10" FontWeight="Bold" Height="170">
                    <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtHistory" TextElement.FontWeight="Normal" TextWrapping="Wrap" FontSize="11" Foreground="#333"/>
                    </ScrollViewer>
                </GroupBox>
            </StackPanel>

            <GroupBox Grid.Column="1" Header="План теплицы (Вид сверху)" Padding="10" FontWeight="Bold">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="TxtHeader" Text="Ожидание запуска..." FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtRegime" Text="" FontSize="13" HorizontalAlignment="Center" Foreground="#555" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid x:Name="PlanHost" Grid.Row="1" Margin="10" SizeChanged="PlanHost_SizeChanged">
                        <Border x:Name="PlanFrame" BorderBrush="#333" BorderThickness="3" Background="#EEF1EA"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid>
                                <Canvas x:Name="HeatmapCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                                <Canvas x:Name="GridCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                                <Canvas x:Name="GreenhouseCanvas" ClipToBounds="True" Background="Transparent"
                                        SizeChanged="GreenhouseCanvas_SizeChanged"
                                        MouseMove="GreenhouseCanvas_MouseMove" MouseLeave="GreenhouseCanvas_MouseLeave"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="LegendPanel" Grid.Row="2" Margin="10,0,10,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtLegendTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <Rectangle x:Name="LegendBar" Height="14" Stroke="#66000000" StrokeThickness="0.5"/>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="LegendRange" Height="14" Stroke="Black" StrokeThickness="1.5"
                                           Fill="#33FFFFFF" RadiusX="2" RadiusY="2"/>
                            </Canvas>
                        </Grid>
                        <Canvas x:Name="LegendTicks" Grid.Row="1" Grid.Column="1" Height="20" SizeChanged="LegendTicks_SizeChanged"/>
                        <TextBlock x:Name="TxtLegendRange" Grid.Row="2" Grid.ColumnSpan="2" Foreground="#444" FontSize="12" Margin="0,2,0,0"/>
                    </Grid>

                    <TextBlock x:Name="TxtCellProbe" Grid.Row="3" Margin="10,4,10,0" Foreground="#333" FontSize="12"
                               TextTrimming="CharacterEllipsis" Text="Наведите курсор на клетку, чтобы увидеть её показатели"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Всплывающее окно плана -->
        <Grid x:Name="OverlayNewPlan" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="White" Width="460" MaxHeight="640" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Отмена" Click="BtnCancelPlan_Click" Padding="15,7" Margin="0,0,10,0"/>
                        <Button Content="Сохранить" Click="BtnSavePlan_Click" Padding="15,7" Background="#4CAF50" Foreground="White"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="PlanFormTitle" Text="Новый план" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                            <TextBlock Text="Название культуры:" />
                            <TextBox x:Name="InputCropName" Margin="0,0,0,10" Padding="4" />

                            <TextBlock Text="Длительность, суток:" />
                            <TextBox x:Name="InputDuration" Text="1" Margin="0,0,0,10" Padding="4" />

                            <TextBlock Text="Дневная температура, °C" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Мин" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputDayTempMin" Text="23" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Идеал" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputDayTempTarget" Text="25" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Макс" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputDayTempMax" Text="27" Padding="4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Ночная температура, °C" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Мин" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputNightTempMin" Text="20" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Идеал" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputNightTempTarget" Text="22" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Макс" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputNightTempMax" Text="24" Padding="4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Длина дня, часов:" />
                            <TextBox x:Name="InputDayLength" Text="16" Margin="0,0,0,10" Padding="4" />

                            <TextBlock Text="Влажность, %" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Мин" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputHumMin" Text="60" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Идеал" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputHumTarget" Text="65" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Макс" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputHumMax" Text="70" Padding="4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Уровень pH" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Мин" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputPhMin" Text="5.5" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Идеал" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputPhTarget" Text="6.0" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Макс" Foreground="Gray" FontSize="11"/>
                                    <TextBox x:Name="InputPhMax" Text="6.5" Padding="4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Освещение, часов:" />
                            <TextBox x:Name="InputLight" Text="14" Margin="0,0,0,0" Padding="4" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>